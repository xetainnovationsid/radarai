# Public configuration consumed by the browser app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Firebase OAuth Configuration (Web Client & Server Token Verification)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Set true on Vercel production to require researcher login before study upload/review:
NEXT_PUBLIC_REQUIRE_AUTH=false

# Server-side API configuration. Keep secrets out of this file and out of Git.
RADAR_ENV=development
RADAR_LOG_LEVEL=INFO
RADAR_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server-side Authentication & Rate Limiting
RADAR_AUTH_REQUIRED=false
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
RADAR_ALLOWED_EMAIL_DOMAINS=
RADAR_REQUIRE_VERIFIED_EMAIL=true
RADAR_API_KEYS=
RADAR_API_SECRET_KEY=
RADAR_TRUST_PROXY_HEADERS=false
RADAR_RATE_LIMIT_PER_MINUTE=120
RADAR_UPLOAD_RATE_LIMIT_PER_MINUTE=20
RADAR_INFERENCE_RATE_LIMIT_PER_MINUTE=30

# Optional local research-only DenseNet121 checkpoint (weights are never committed).
RADAR_CT_CHECKPOINT=data/model-artifacts/ct-binary-densenet121.pt
RADAR_CT_DEVICE=auto
RADAR_ICH_SCORE_THRESHOLD=0.5

# Optional offline SAMIHS lesion localization. Download the pinned pretrained
# package once using apps/api/scripts/download_samihs_model.py. Never trains.
RADAR_ICH_SEGMENTATION_ROOT=data/model-artifacts/samihs-ich-segmentation
RADAR_ICH_SEGMENTATION_DEVICE=auto
RADAR_ICH_SEGMENTATION_BATCH_SIZE=1
RADAR_ICH_SEGMENTATION_THRESHOLD=0.5

# Optional Meta Model API smoke test. Keep the actual key only in your local environment.
MODEL_API_KEY=
RADAR_MODEL_ID=muse-spark-1.3
